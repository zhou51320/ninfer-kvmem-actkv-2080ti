+            score[nt][1]   = (row0 < s.row_count && in1 && key1 <= qabs0) ? score[nt][1] * s.scale
+                                                                          : -CUDART_INF_F;
+            score[nt][2]   = (row1 < s.row_count && in0 && key0 <= qabs1) ? score[nt][2] * s.scale
+                                                                          : -CUDART_INF_F;
+            score[nt][3]   = (row1 < s.row_count && in1 && key1 <= qabs1) ? score[nt][3] * s.scale
+                                                                          : -CUDART_INF_F;
