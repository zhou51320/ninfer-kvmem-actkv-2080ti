+#pragma unroll
+            for (int k = 0; k < QKKs; ++k) {
+                unsigned bf[2];
+                const int brow = nt * 8 + b_rin;
+                const int bcol = k * 16 + b_koff;
+                ldmatrix_x2(bf[0], bf[1],
