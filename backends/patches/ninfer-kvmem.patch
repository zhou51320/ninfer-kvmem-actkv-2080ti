+    float bm0 = -CUDART_INF_F, bm1 = -CUDART_INF_F;
+    if (full_score_tile) {
+#pragma unroll
+        for (int nt = 0; nt < QKNt; ++nt) {
+            bm0 = fmaxf(bm0, fmaxf(score[nt][0], score[nt][1]));
+            bm1 = fmaxf(bm1, fmaxf(score[nt][2], score[nt][3]));
+        }
