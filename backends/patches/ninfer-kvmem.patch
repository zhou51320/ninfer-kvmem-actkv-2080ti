+        output.ne[0] != input.ne[0] || output.ne[1] != buckets ||
+        output.ne[2] != 1 || output.ne[3] != 1 || overlaps(input, output) ||
+        overlaps(origin, output) || overlaps(range, output) || overlaps(input, origin) ||
+        overlaps(input, range) || overlaps(origin, range)) {
